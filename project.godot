; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Azyrel"
run/main_scene="res://assets/scenes/levels/development_level.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"akyra": "res://assets/scenes/dialogue/characters/akyra.dch",
"azyrel": "res://assets/scenes/dialogue/characters/azyrel.dch"
}
directories/dtl_directory={
"akyra_dev1": "res://assets/scenes/dialogue/akyra_dev1.dtl",
"akyra_dev2": "res://assets/scenes/dialogue/akyra_dev2.dtl",
"akyra_tutor1_open": "res://assets/scenes/dialogue/akyra_tutor1_open.dtl",
"akyra_tutor2_open": "res://assets/scenes/dialogue/akyra_tutor2_open.dtl",
"akyra_tutor3_open": "res://assets/scenes/dialogue/akyra_tutor3_open.dtl",
"akyra_tutor4_open": "res://assets/scenes/dialogue/akyra_tutor4_open.dtl",
"akyra_tutor5_open": "res://assets/scenes/dialogue/akyra_tutor5_open.dtl"
}
layout/style_list=[]
layout/default_style="res://assets/scenes/dialogue/default_style.tres"
glossary/default_case_sensitive=true
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.02
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.0
animations/join_default_wait=false
animations/leave_default_length=0.0
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
text/autocolor_names=false
variables={}
animations/join_default="Instant In"
animations/leave_default="Instant Out"
portraits/default_portrait=""
text/autoadvance_fixed_delay=2.0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080

[dotnet]

project/assembly_name="Azyrel"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

